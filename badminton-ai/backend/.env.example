# Copy to .env and adjust for your machine.

APP_NAME="Badminton AI"
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_CREATE_TABLES=true

# SQLite is the production target for PythonAnywhere Free.
DATABASE_URL=sqlite+aiosqlite:///./badminton_dev.db

JWT_SECRET_KEY=generate-a-secure-random-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=20160

LOCAL_STORAGE_DIR=./data/uploads
PROCESS_JOBS_INLINE=true
MAX_UPLOAD_BYTES=104857600

# Coaching LLM via OpenRouter (free-tier friendly, OpenAI-compatible REST API).
# Get a key at https://openrouter.ai/keys - no credit card required for free models.
# Leave blank to use the deterministic local coaching fallback instead.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# "openrouter/free" auto-selects from currently-available free models, since
# specific ":free" model IDs get deprecated/rotated frequently. Pin a specific
# model instead if you want reproducible output, e.g.:
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://badminton-ai.local
OPENROUTER_APP_NAME=Badminton AI
